# Fast Knowledge — 环境变量示例
# 复制为 docker/.env 或导出到 shell 后启动应用
# ECS 部署：cp .env.example .env.ecs → 编辑凭据 → sudo bash scripts/install.sh install --env-file .env.ecs

# ===== ECS 部署（必填）=====
# 知识版型：community（社区版）| enterprise（企业版，含 Wiki Agent / 写文档图编排）
KNOWLEDGE_EDITION=enterprise

# MySQL 5.7（ECS 上推荐使用云数据库 RDS）
DB_URL="jdbc:mysql://localhost:3306/fast_knowledge?useUnicode=true&characterEncoding=utf8&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai"
DB_USER=root
DB_PASSWORD=root

# 存储提供方：minio（私有化/离线）| oss（阿里云对象存储）| local（本地目录，单机极简）
STORAGE_PROVIDER=minio

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# MinIO（S3 兼容，STORAGE_PROVIDER=minio 时必填）
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=fast-knowledge
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_REGION=us-east-1

# 阿里云 OSS（STORAGE_PROVIDER=oss 时必填）
# OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
# OSS_BUCKET=fast-knowledge
# OSS_ACCESS_KEY=
# OSS_SECRET_KEY=
# OSS_REGION=cn-hangzhou

# 本地目录存储（STORAGE_PROVIDER=local 时使用，无需外部对象存储）
# STORAGE_PROVIDER=local
# STORAGE_LOCAL_DIR=./data/files

# JWT（生产必改，≥32 字符）
JWT_SECRET=fast-knowledge-jwt-secret-change-in-production-32chars

# Embedding（OpenAI 兼容 /v1/embeddings：DashScope compatible-mode、硅基流动、OpenAI 等）
EMBEDDING_PROVIDER=openai
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIMENSION=1024
# 向量存储：本地文件索引（./data/vectors，按知识库分文件）
VECTOR_LOCAL_DIR=./data/vectors

# LLM（OpenAI 兼容 API）
# 推荐：阿里云百炼 DashScope（兼容模式）
LLM_PROVIDER=dashscope
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen-plus
LLM_ALLOW_EXTERNAL=true
# 内网 Ollama 备选：
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:7b

# Reranker（可选，提升检索精度；仅云端 Cohere/Jina，内网纯离线模式必须关闭）
RERANK_ENABLED=false
RERANK_PROVIDER=cohere
RERANK_CANDIDATE_MULTIPLIER=3
# RERANK_MIN_SCORE=0.2
COHERE_API_KEY=
# RERANK_COHERE_MODEL=rerank-multilingual-v3.0
JINA_API_KEY=
# RERANK_JINA_MODEL=jina-reranker-v2-base-multilingual

# CORS
CORS_ORIGINS=*

# SQL 初始化（首次部署 always，后续可改为 never）
SQL_INIT_MODE=always

# ===== 可选特性 =====
# WP1 上下文化分块：入库时用 LLM 为每个 chunk 生成上下文前缀再向量化（提升跨块检索，增加索引期 LLM 用量）
KNOWLEDGE_INGEST_CONTEXTUAL_ENABLED=false
# WP2 扫描件 OCR：扫描 PDF / 图片文档用视觉模型（knowledge.vision.model）逐页转 Markdown 入库
KNOWLEDGE_INGEST_OCR_ENABLED=false
# WP7 知识图谱：索引后 LLM 抽取实体关系，检索时邻居 chunk 扩展召回
KNOWLEDGE_KG_ENABLED=false
# WP8 MCP Server：/api/v1/mcp 端点（工具 list_kbs/search/qa/fetch_chunk，API Key 鉴权）
KNOWLEDGE_MCP_ENABLED=false
KNOWLEDGE_INGEST_OCR_MAX_PAGES=50
# Wiki Agent 自动合并（需 enterprise 版型）
WIKI_AGENT_ENABLED=false
# 写文档图编排（需 enterprise 版型）
WRITER_GRAPH_ENABLED=false
# 缓存提供方：redis（默认）| caffeine（无外部依赖）
# CACHE_PROVIDER=caffeine
